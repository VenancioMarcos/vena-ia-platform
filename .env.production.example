# Copy to .env.production outside version control and replace every required value.
APP_ENV=production

POSTGRES_DB=vena_ia
POSTGRES_USER=vena_ia
POSTGRES_PASSWORD=replace-with-a-secret-manager-value
DATABASE_URL=postgresql+psycopg://vena_ia:replace-with-a-secret-manager-value@postgres:5432/vena_ia

REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-a-secret-manager-value
MINIO_SECRET_KEY=replace-with-a-secret-manager-value
MINIO_BUCKET=vena-ia-files
MINIO_SECURE=false

AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
AUTH_SECURITY_STORE=redis
AUTH_LOGIN_RATE_LIMIT_REQUESTS=10
AUTH_REGISTRATION_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

JOBS_QUEUE_PROVIDER=redis
CORS_ORIGINS=["https://beta.example.com"]
NEXT_PUBLIC_API_URL=https://api.beta.example.com

OPENAI_API_KEY=
RAG_AI_PROVIDER=openai
OBSERVABILITY_COLLECTION_ENABLED=true
OBSERVABILITY_METRICS_ENDPOINT_ENABLED=false

# Backup files must stay outside the repository and on protected storage.
BACKUP_OUTPUT_DIRECTORY=/var/lib/vena-ia/backups
BACKUP_RESTORE_ALLOWED_DATABASE=vena_ia_restore
BACKUP_MINIO_RESTORE_ALLOWED_BUCKET=vena-ia-restore
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_CONSISTENCY_GUARD=quiesced
BACKUP_SET_PROTECTED=true
