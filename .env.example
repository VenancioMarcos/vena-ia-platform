APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vena_ia
POSTGRES_USER=vena_ia
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://vena_ia:change_me@postgres:5432/vena_ia

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=vena-ia-files
MINIO_SECURE=false

DOCUMENT_MAX_FILE_SIZE=104857600
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_AI_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini
RAG_EMBEDDING_DIMENSIONS=1536
RAG_SEARCH_LIMIT=5

OPENAI_API_KEY=

AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRATION_MINUTES=30
AUTH_COOKIE_NAME=vena_ia_session
AUTH_COOKIE_SECURE=false
PASSWORD_HASH_ITERATIONS=600000
AUTH_LOGIN_RATE_LIMIT_REQUESTS=10
AUTH_REGISTRATION_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_SECURITY_STORE=redis
AUTH_REDIS_PREFIX=vena_ia:auth
AUTH_REDIS_TIMEOUT_SECONDS=1.0
SECURITY_AUDIT_RETENTION_DAYS=90
OBSERVABILITY_COLLECTION_ENABLED=true
# Remains false unless an authenticated admin endpoint is explicitly required.
OBSERVABILITY_METRICS_ENDPOINT_ENABLED=false
OBSERVABILITY_ALERT_COOLDOWN_SECONDS=30

# Backup artifacts must resolve outside the repository.
BACKUP_OUTPUT_DIRECTORY=../vena-ia-backups
BACKUP_RESTORE_ALLOWED_DATABASE=vena_ia_restore
BACKUP_MINIO_RESTORE_ALLOWED_BUCKET=vena-ia-restore
# Classe aplicada ao novo conjunto; políticas de idade/quantidade são flags da retenção.
BACKUP_RETENTION_CLASS=daily
# Base64 de 32 bytes fornecida somente por secret manager/arquivo externo protegido.
BACKUP_ENCRYPTION_KEY=
# Identificador não sensível da chave; preserve chaves antigas fora do repositório.
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_CONSISTENCY_GUARD=quiesced
BACKUP_JOB_TIMEOUT_SECONDS=3600
BACKUP_SET_PROTECTED=false
